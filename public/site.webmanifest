{
  "id": "/",
  "name": "i18n=manifest.name",
  "short_name": "i18n=manifest.name.short",
  "description": "i18n=manifest.description",
  "lang": "[[[LANG]]]",
  "dir": "[[[DIR]]]",

  "start_url": "/[[[LANG]]]/",
  "scope": "/",

  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",

  "theme_color": "[[[LIGHT_THEME_COLOR]]]",
  "background_color": "[[[LIGHT_THEME_COLOR]]]",
  "color_scheme_dark": {
    "theme_color": "[[[DARK_THEME_COLOR]]]",
    "background_color": "[[[DARK_THEME_COLOR]]]"
  },

  "categories": [
    "education",
    "productivity",
    "utilities"
  ],

  "icons": [
    {
      "src": "/assets/icons/icon_192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon_maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [],

  "screenshots": [
    {
      "src": "/assets/screenshots/desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/assets/screenshots/mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}